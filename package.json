{
  "name": "blockfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Block Fall — a grid puzzle. Free, no ads, no tracking, plays offline.",
  "scripts": {
    "test": "node --test web/tests/*.test.js",
    "serve": "node web/scripts/serve.mjs",
    "gen": "node scripts/generate-skins.mjs && node scripts/generate-strings.mjs",
    "gen:check": "node scripts/generate-skins.mjs --check && node scripts/generate-strings.mjs --check",
    "icons": "python3 scripts/generate-icons.py"
  },
  "license": "MIT"
}
